<% field = "mt-1 block rounded-md border border-gray-300 bg-white px-2 py-1.5 text-sm text-gray-900" %>
<div class="space-y-3 rounded-lg border border-gray-200 bg-white p-4">
  <nav class="flex flex-wrap gap-2 text-sm" aria-label="Date range">
    <% range_presets(last_day).each do |label, range| %>
      <% active = @filter.from&.iso8601 == range[:from] && @filter.to&.iso8601 == range[:to] %>
      <%= link_to label, account_path(@account, **@filter.to_params.except(:from, :to), **range.compact),
            aria: { current: ("true" if active) },
            class: [ "rounded-full border px-3 py-1", active ? "border-blue-600 bg-blue-600 text-white" : "border-gray-300 text-gray-700 hover:border-blue-400" ] %>
    <% end %>
  </nav>

  <%= form_with url: account_path(@account), method: :get, class: "flex flex-wrap items-end gap-3 text-sm text-gray-600" do |form| %>
    <label>From
      <%= form.date_field :from, value: @filter.from&.iso8601, min: first_day, max: last_day, class: field %>
    </label>
    <label>To
      <%= form.date_field :to, value: @filter.to&.iso8601, min: first_day, max: last_day, class: field %>
    </label>
    <label>Symbol
      <%= form.select :symbol, options_for_select(@account.trades.distinct.order(:symbol).pluck(:symbol), @filter.symbol), { include_blank: "All symbols" }, class: field %>
    </label>
    <label>Robot
      <%= form.select :robot_id, options_from_collection_for_select(@account.robots.order(:name), :id, :name, @filter.robot_id), { include_blank: "All robots" }, class: field %>
    </label>
    <%= form.submit "Apply", name: nil, class: "cursor-pointer rounded-md bg-blue-600 px-4 py-1.5 font-medium text-white hover:bg-blue-500" %>
    <% if @filter.active? %>
      <%= link_to "Clear filters", account_path(@account), class: "py-1.5 text-blue-600 underline" %>
    <% end %>
  <% end %>
</div>
