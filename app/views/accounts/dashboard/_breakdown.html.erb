<%# Rows with long and short trades open with <details>, so no JavaScript is needed. %>
<% columns = "grid grid-cols-[minmax(0,2fr)_repeat(2,minmax(0,1fr))_minmax(0,1fr)_minmax(0,2fr)] gap-2 px-1 py-2" %>
<section class="rounded-lg border border-gray-200 bg-white p-4 text-sm">
  <h2 class="mb-3 text-lg font-semibold"><%= title %></h2>
  <div class="overflow-x-auto">
    <div class="min-w-[28rem] tabular-nums">
      <div class="<%= columns %> border-b border-gray-200 font-medium text-gray-600">
        <span><%= label %></span>
        <span class="text-right">Trades</span>
        <span class="text-right">Win rate</span>
        <span class="text-right" title="Profit factor">PF</span>
        <span class="text-right">Net profit</span>
      </div>
      <% rows.each do |row| %>
        <% if row.sides.any? %>
          <details class="border-b border-gray-100">
            <summary class="<%= columns %> cursor-pointer list-none hover:bg-gray-50">
              <%= render "accounts/dashboard/breakdown_cells", row:, expandable: true %>
            </summary>
            <% row.sides.each do |side| %>
              <div class="<%= columns %> bg-gray-50 text-gray-600">
                <%= render "accounts/dashboard/breakdown_cells", row: side, expandable: false %>
              </div>
            <% end %>
          </details>
        <% else %>
          <div class="<%= columns %> border-b border-gray-100">
            <%= render "accounts/dashboard/breakdown_cells", row:, expandable: false %>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
  <% if rows.any? { _1.sides.any? } %>
    <p class="mt-2 text-xs text-gray-500">Select a robot to split it into long and short trades.</p>
  <% end %>
</section>
