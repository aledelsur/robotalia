<% currency = @account.currency %>
<% mt5_note = if summary.break_even.zero?
     "No break-even trades, so MT5's rate is the same."
   else
     "MT5 shows #{percent(summary.mt5_win_rate)}: it counts #{pluralize(summary.break_even, "break-even trade")} as won."
   end %>
<% tiles = [
     [ "Return", percent(summary.return_rate, precision: 2), "Net profit ÷ (starting balance + deposits in the range)" ],
     [ "Win rate", percent(summary.win_rate), mt5_note ],
     [ "Profit factor", ratio(summary.profit_factor), summary.profit_factor ? "Gross profit ÷ gross loss" : "No losing trades in this range" ],
     [ "Expectancy", money(summary.expectancy, currency), "Average net profit per trade" ],
     [ "Max drawdown", percent(curve.max_drawdown_rate, precision: 2), "Largest fall from a peak. In money: #{money(curve.max_drawdown, currency)}" ],
     [ "Longest losing streak", pluralize(summary.longest_losing_streak, "trade"), "Consecutive losses in closing order" ],
     [ "Average win", money(summary.average_win, currency), "Largest: #{money(summary.largest_win, currency)}" ],
     [ "Average loss", money(summary.average_loss, currency), "Largest: #{money(summary.largest_loss, currency)}" ]
   ] %>
<section aria-label="Performance summary" class="space-y-4">
  <div class="rounded-lg border border-gray-200 bg-white p-5">
    <p class="text-sm text-gray-600">Net profit of closed trades, after commission and swap</p>
    <p class="mt-1 text-5xl font-semibold <%= profit_class(summary.net_profit) %>" data-testid="net-profit"><%= money(summary.net_profit, currency) %></p>
    <p class="mt-2 text-sm text-gray-600">
      <%= pluralize(number_with_delimiter(summary.trades), "trade") %>:
      <%= summary.wins %> won, <%= summary.losses %> lost, <%= summary.break_even %> break-even
    </p>
  </div>
  <dl class="grid grid-cols-2 gap-4 lg:grid-cols-4">
    <% tiles.each do |label, value, note| %>
      <div class="rounded-lg border border-gray-200 bg-white p-4">
        <dt class="text-sm text-gray-600"><%= label %></dt>
        <dd class="mt-1 text-2xl font-semibold"><%= value %></dd>
        <dd class="mt-1 text-xs text-gray-500"><%= note %></dd>
      </div>
    <% end %>
  </dl>
</section>
