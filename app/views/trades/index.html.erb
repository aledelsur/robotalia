<% content_for :title, "Trades · #{@account.name}" %>
<%= turbo_frame_tag "trades" do %>
  <% if @trades.empty? %>
    <p class="py-6 text-center text-sm text-gray-600">No trades on this page.</p>
  <% else %>
    <div class="overflow-x-auto">
      <table class="w-full whitespace-nowrap text-sm tabular-nums">
        <thead class="text-gray-600">
          <tr class="border-b border-gray-200">
            <%= sort_header "Closed", "closed_at" %>
            <%= sort_header "Opened", "opened_at" %>
            <%= sort_header "Symbol", "symbol" %>
            <%= sort_header "Side", "side" %>
            <%= sort_header "Robot", "robot" %>
            <%= sort_header "Volume", "volume", numeric: true %>
            <th scope="col" class="px-3 py-2 text-right font-medium">Open price</th>
            <th scope="col" class="px-3 py-2 text-right font-medium">Close price</th>
            <th scope="col" class="px-3 py-2 text-right font-medium">Commission</th>
            <th scope="col" class="px-3 py-2 text-right font-medium">Swap</th>
            <%= sort_header "Net profit", "net_profit", numeric: true %>
          </tr>
        </thead>
        <tbody>
          <% @trades.each do |trade| %>
            <tr class="border-b border-gray-100" data-position="<%= trade.position_id %>">
              <td class="px-3 py-1.5"><%= trade.closed_at.strftime("%Y-%m-%d %H:%M") %></td>
              <td class="px-3 py-1.5"><%= trade.opened_at.strftime("%Y-%m-%d %H:%M") %></td>
              <td class="px-3 py-1.5"><%= trade.symbol %></td>
              <td class="px-3 py-1.5"><%= Metrics::Breakdown::SIDES.fetch(trade.side) %></td>
              <td class="px-3 py-1.5"><%= trade.robot&.name || Metrics::Breakdown::NO_ROBOT %></td>
              <td class="px-3 py-1.5 text-right"><%= number_with_precision(trade.volume, precision: 2) %></td>
              <td class="px-3 py-1.5 text-right"><%= number_with_precision(trade.open_price, precision: 5, strip_insignificant_zeros: true) %></td>
              <td class="px-3 py-1.5 text-right"><%= number_with_precision(trade.close_price, precision: 5, strip_insignificant_zeros: true) %></td>
              <td class="px-3 py-1.5 text-right"><%= number_with_precision(trade.commission, precision: 2) %></td>
              <td class="px-3 py-1.5 text-right"><%= number_with_precision(trade.swap, precision: 2) %></td>
              <td class="px-3 py-1.5 text-right <%= profit_class(trade.net_profit) %>"><%= money(trade.net_profit, @account.currency) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <div class="mt-3 flex flex-wrap items-center justify-between gap-3 text-sm text-gray-600">
    <p>
      <%= number_with_delimiter(@pagy.from) %>–<%= number_with_delimiter(@pagy.to) %> of <%= number_with_delimiter(@pagy.count) %>
      · broker server time
    </p>
    <% if @pagy.last > 1 %>
      <%== @pagy.series_nav %>
    <% end %>
  </div>
<% end %>
