<%# Also rendered by the job for Turbo Stream broadcasts, so it must not depend on the request. %>
<div id="<%= dom_id account_import %>" class="mt-6 max-w-2xl rounded-lg border border-gray-200 bg-white p-5"
     <% unless account_import.finished? %>data-controller="poll"<% end %>>
  <p class="text-lg font-semibold" role="status">
    <%= { "queued" => "Queued…", "processing" => "Processing…" }.fetch(account_import.status) { account_import.status.humanize } %>
  </p>

  <% if account_import.completed? %>
    <dl class="mt-3 grid grid-cols-4 gap-3">
      <% { "New" => account_import.new_count, "Updated" => account_import.updated_count,
           "Skipped" => account_import.skipped_count, "Row errors" => account_import.error_count }.each do |label, value| %>
        <div>
          <dt class="text-sm text-gray-600"><%= label %></dt>
          <dd class="text-2xl font-semibold"><%= value %></dd>
        </div>
      <% end %>
    </dl>
    <p class="mt-2 text-sm text-gray-600">Counts cover closed trades and balance operations.</p>
    <%= link_to "View account", account_path(account_import.account), class: "mt-3 inline-block text-blue-600 underline" %>
  <% end %>

  <% if account_import.error_messages.any? %>
    <ul class="mt-3 list-disc pl-5 text-sm text-red-700">
      <% account_import.error_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>
</div>
