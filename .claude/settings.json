{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.deploy)",
      "Read(./config/master.key)",
      "Read(./config/credentials/*.key)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard_commit.sh", "timeout": 30 }
        ]
      }
    ]
  }
}
