# Copy to .env (ignored by git) and fill in. Never commit real values.

# Needed only for real Claude calls. Tests run without it.
ANTHROPIC_API_KEY=

# The single owner account, created by `bin/rails db:seed`.
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=

# Host ports for docker compose. Change them if something else uses the defaults.
WEB_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
